{
  "name": "uncov-business-suite",
  "private": true,
  "version": "9.0.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "NODE_ENV=development electron .",
    "rebuild": "electron-rebuild",
    "dist": "npm run rebuild && npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "boxicons": "^2.1.4",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "html2pdf.js": "^0.10.3",
    "lucide-react": "^0.525.0",
    "node-machine-id": "^1.1.12",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.17.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-datepicker": "^8.3.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.0",
    "react-tooltip": "^5.28.1",
    "recharts": "^3.0.2",
    "sqlite3": "^5.1.7",
    "to-words": "^4.6.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.sliderlogin.app",
    "productName": "Business Suite",
    "asarUnpack": [
      "users.db",
      "*.json",
      "print-helper/**"
    ],
    "extraResources": [
      {
        "from": "print-helper/",
        "to": "print-helper",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "*.cjs",
      "users.db",
      "app_assets/**/*",
      "preload-license.cjs",
      "public/**/*",
      "license.cjs"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/uNCov.ico",
      "target": "nsis",
      "artifactName": "Business Suite.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Business Suite"
    }
  }
}
